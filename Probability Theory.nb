Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Inputs", " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pDisease", " ", "=", " ", "0.01"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pHealthy", " ", "=", " ", 
     RowBox[{"1", " ", "-", " ", "pDisease"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pPosGivenDisease", " ", "=", " ", "0.99"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pPosGivenHealthy", " ", "=", " ", "0.02"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Total", " ", "Probability"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"pPos", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"pPosGivenDisease", " ", "*", " ", "pDisease"}], ")"}], " ", "+",
       " ", 
      RowBox[{"(", 
       RowBox[{"pPosGivenHealthy", " ", "*", " ", "pHealthy"}], ")"}]}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Bayes", "'"}], " ", "Theorem"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"pDiseaseGivenPos", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"pPosGivenDisease", " ", "*", " ", "pDisease"}], ")"}], " ", "/",
       " ", "pPos"}]}], ";"}], "\n", "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<P(Disease | Positive) = \>\"", ",", " ", 
     RowBox[{"N", "[", "pDiseaseGivenPos", "]"}]}], "]"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Output", ":", " ", "0.333333"}], " ", "*)"}], "\n"}]}]], "Code",
 CellChangeTimes->{4.00033876062475*^9},
 CellLabel->"In[91]:=",ExpressionUUID->"84d574e4-7509-6a4b-a330-37014392c49f"],


  RowBox[{"(*", " ", 
   RowBox[{"Softmax", " ", "functional", " ", "definition"}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"softmax", "[", "logits_List", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Exp", "[", "logits", "]"}], " ", "/", " ", 
      RowBox[{"Total", "[", 
       RowBox[{"Exp", "[", "logits", "]"}], "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"logits", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"2.0", ",", " ", "1.0", ",", " ", "0.1"}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Orders", ":", " ", "Cat"}], ",", " ", "Dog", ",", " ", "Bird"}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"probabilities", " ", "=", " ", 
     RowBox[{"softmax", "[", "logits", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Probabilities {Cat, Dog, Bird}: \>\"", ",", " ", 
      RowBox[{"N", "[", "probabilities", "]"}]}], "]"}], ";"}], "\n", 

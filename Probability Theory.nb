Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Class", " ", "Priors"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pSports", " ", "=", " ", "0.5"}], ";", " ", 
    RowBox[{"pNotSports", " ", "=", " ", "0.5"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Feature", " ", "Likelihoods"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"pBallGivenSports", " ", "=", " ", "0.6"}], ";", " ", 
    RowBox[{"pRunGivenSports", " ", "=", " ", "0.4"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pBallGivenNotSports", " ", "=", " ", "0.1"}], ";", " ", 
    RowBox[{"pRunGivenNotSports", " ", "=", " ", "0.2"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Naive", " ", "Bayes", " ", "Scores"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"scoreSports", " ", "=", " ", 
     RowBox[{
     "pSports", " ", "*", " ", "pBallGivenSports", " ", "*", " ", 
      "pRunGivenSports"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"scoreNotSports", " ", "=", " ", 
     RowBox[{
     "pNotSports", " ", "*", " ", "pBallGivenNotSports", " ", "*", " ", 
      "pRunGivenNotSports"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Sports Score: \>\"", ",", " ", "scoreSports"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Not Sports Score: \>\"", ",", " ", "scoreNotSports"}], 
     "]"}], ";"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Prediction: \>\"", ",", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"scoreSports", " ", ">", " ", "scoreNotSports"}], ",", 
       " ", "\"\<Sports\>\"", ",", " ", "\"\<Not Sports\>\""}], "]"}]}], 
    "]"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Output", ":", " ", "Prediction", ":", " ", "Sports"}], " ", 
    "*)"}], "\n"}]}]], "Code",

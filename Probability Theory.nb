 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Define", " ", "the", " ", "Sample", " ", "Space", " ", "and", " ", 
    "uniform", " ", "probabilities", " ", "for", " ", "a", " ", "fair", " ", 
    "die"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sampleSpace", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "5", ",", 

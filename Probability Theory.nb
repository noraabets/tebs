Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"montyHallSim", "[", "strategy_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "doors", ",", " ", "carDoor", ",", " ", "playerChoice", ",", " ", 
        "montyOpens", ",", " ", "finalChoice"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"doors", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], ";", "\n", 
       "  ", 
       RowBox[{"carDoor", " ", "=", " ", 
        RowBox[{"RandomChoice", "[", "doors", "]"}]}], ";", "\n", "  ", 
       RowBox[{"playerChoice", " ", "=", " ", 
        RowBox[{"RandomChoice", "[", "doors", "]"}]}], ";", "\n", "  ", "\n", 
       "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Monty", " ", "opens", " ", "a", " ", "door", " ", "that", " ", "is", 
         " ", "NOT", " ", "the", " ", 
         RowBox[{"player", "'"}], "s", " ", "choice", " ", "and", " ", "NOT", 
         " ", "the", " ", "car"}], " ", "*)"}], "\n", "  ", 
       RowBox[{"montyOpens", " ", "=", " ", 
        RowBox[{"RandomChoice", "[", 
         RowBox[{"Complement", "[", 
          RowBox[{"doors", ",", " ", 
           RowBox[{"{", 
            RowBox[{"playerChoice", ",", " ", "carDoor"}], "}"}]}], "]"}], 
         "]"}]}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"strategy", " ", "==", " ", "\"\<Switch\>\""}], ",", "\n", 
         "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Final", " ", "choice", " ", "is", " ", "the", " ", "remaining", " ",
            "unopened", " ", "door"}], " ", "*)"}], "\n", "    ", 
         RowBox[{"finalChoice", " ", "=", " ", 
          RowBox[{"First", "[", 
           RowBox[{"Complement", "[", 
            RowBox[{"doors", ",", " ", 
             RowBox[{"{", 
              RowBox[{"playerChoice", ",", " ", "montyOpens"}], "}"}]}], 
            "]"}], "]"}]}], ",", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{"Strategy", " ", "is", " ", "\"\<Stay\>\""}], " ", "*)"}], 
         "\n", "    ", 
         RowBox[{"finalChoice", " ", "=", " ", "playerChoice"}]}], "\n", "  ",
         "]"}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Return", " ", "1", " ", "if", " ", "won"}], ",", " ", 
         RowBox[{"0", " ", "if", " ", "lost"}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"finalChoice", " ", "==", " ", "carDoor"}], ",", " ", "1", ",",
          " ", "0"}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", "\n", 

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Define", " ", "the", " ", "Standard", " ", "Normal", " ", "Distribution", 
    " ", "PDF"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "/", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", "*", " ", "Pi"}], "]"}]}], ")"}], " ", "*", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"x", "^", "2"}]}], " ", "/", " ", "2"}], "]"}]}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Axiom", " ", "1", " ", 
     RowBox[{"Verification", ":", " ", 
      RowBox[{
      "Test", " ", "if", " ", "the", " ", "function", " ", "is", " ", 
       "always", " ", "positive"}]}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Instead", " ", "of", " ", "Minimize"}], ",", " ", 
     RowBox[{
      RowBox[{"we", " ", "verify", " ", "that", " ", 
       RowBox[{"f", "[", "x", "]"}]}], " ", ">", " ", 
      RowBox[{"0", " ", "for", " ", "all", " ", "real", " ", "x"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "We", " ", "can", " ", "check", " ", "the", " ", "limit", " ", "at", " ", 
     "infinity", " ", 
     RowBox[{"(", 
      RowBox[{"approaches", " ", "0"}], ")"}], " ", "and", " ", "that", " ", 
     RowBox[{"it", "'"}], "s", " ", "never", " ", "negative"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"isPositive", " ", "=", " ", 
     RowBox[{"Resolve", "[", 
      RowBox[{"ForAll", "[", 
       RowBox[{"x", ",", " ", 
        RowBox[{"Element", "[", 
         RowBox[{"x", ",", " ", "Reals"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"f", "[", "x", "]"}], " ", ">", " ", "0"}]}], "]"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Axiom 1 (Continuous Non-negativity) Is Always Positive: \
\>\"", ",", " ", "isPositive"}], "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Alternatively", ",", " ", 
     RowBox[{
      RowBox[{
      "if", " ", "you", " ", "want", " ", "to", " ", "show", " ", "the", " ", 
       "infimum", " ", "is", " ", "0"}], ":"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"infimumVal", " ", "=", " ", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{"f", "[", "x", "]"}], ",", " ", 
       RowBox[{"x", " ", "->", " ", "Infinity"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Axiom 1 (Infimum Value): \>\"", ",", " ", "infimumVal"}], 
     "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Axiom", " ", "2", " ", 
     RowBox[{"Verification", ":", " ", 
      RowBox[{
      "Integrate", " ", "across", " ", "the", " ", "entire", " ", "real", " ",
        "number", " ", "line"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"totalArea", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"f", "[", "x", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"Element", "[", 
         RowBox[{"x", ",", " ", "Reals"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Axiom 2 (Continuous Total Probability) Integrated Area = \>\
\"", ",", " ", "totalArea"}], "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Output", ":", " ", "\n", "   ", 
      RowBox[{"Axiom", " ", "1", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Continuous", " ", "Non"}], "-", "negativity"}], ")"}], " ", 
       "Is", " ", "Always", " ", "Positive"}], ":", " ", 
      RowBox[{"True", "\n", "   ", "Axiom", " ", "1", " ", 
       RowBox[{"(", 
        RowBox[{"Infimum", " ", "Value"}], ")"}]}], ":", " ", 
      RowBox[{"0", "\n", "   ", "Axiom", " ", "2", " ", 
       RowBox[{"(", 
        RowBox[{"Continuous", " ", "Total", " ", "Probability"}], ")"}], " ", 
       "Integrated", " ", "Area"}]}], " ", "=", " ", "1"}], " ", "\n", 
    "*)"}]}]}]], "Code",
 CellChangeTimes->{4.0003537304694977`*^9},
 CellLabel->
  "In[118]:=",ExpressionUUID->"c1410f75-368f-8548-8e29-234cd07fddf6"],


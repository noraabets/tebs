   RowBox[{
    RowBox[{
     RowBox[{"p", "[", "outcome_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"sampleSpace", ",", " ", "outcome"}], "]"}], ",", " ", 
       RowBox[{"1", "/", "6"}], ",", " ", "0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pEvent", "[", "event_List", "]"}], " ", ":=", " ", 
     RowBox[{"Total", "[", 
      RowBox[{"p", " ", "/@", " ", 
       RowBox[{"DeleteDuplicates", "[", "event", "]"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", " ", "VERIFYING"}]}], " ", "AXIOM", " ", "1"}], ":", " ", 
     RowBox[{"Non", "-", 
      RowBox[{"Negativity", " ", "--"}], "-"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Check", " ", "if", " ", "the", " ", "probability", " ", "of", " ", 
      "every", " ", "possible", " ", "subset", " ", "is"}], " ", ">=", " ", 
     "0"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"allSubsets", " ", "=", " ", 
     RowBox[{"Subsets", "[", "sampleSpace", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"axiom1Verified", " ", "=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"pEvent", " ", "/@", " ", "allSubsets"}], ",", " ", 
       RowBox[{
        RowBox[{"#", " ", ">=", " ", "0"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Axiom 1 (Non-Negativity) Verified: \>\"", ",", " ", 
      "axiom1Verified"}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Output", ":", " ", "True"}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", " ", "VERIFYING"}]}], " ", "AXIOM", " ", "2"}], ":", " ", 
     RowBox[{
      RowBox[{"Total", " ", 
       RowBox[{"Probability", " ", "--"}]}], "-"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Check", " ", "if", " ", "P", 
      RowBox[{"(", "S", ")"}]}], " ", "==", " ", "1"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"pTotal", " ", "=", " ", 
     RowBox[{"pEvent", "[", "sampleSpace", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"axiom2Verified", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{"pTotal", " ", "==", " ", "1"}], ")"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Axiom 2 (Total Probability = 1) Verified: \>\"", ",", " ", 
      "axiom2Verified", ",", " ", "\"\< (Value: \>\"", ",", " ", "pTotal", ",",
       " ", "\"\<)\>\""}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Output", ":", " ", 
     RowBox[{"True", " ", 
      RowBox[{"(", 
       RowBox[{"Value", ":", " ", "1"}], ")"}]}]}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", " ", "VERIFYING"}]}], " ", "AXIOM", " ", "3"}], ":", " ", 
     RowBox[{
      RowBox[{"Additivity", " ", "--"}], "-"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Define", " ", "two", " ", "mutually", " ", "exclusive", " ", "events"}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"eventA", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4", ",", " ", "6"}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Even", " ", "numbers"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"eventB", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "5"}], "}"}]}], ";"}], "    ", 
   RowBox[{"(*", " ", 
    RowBox[{"Odd", " ", "numbers", " ", "excluding", " ", "3"}], " ", "*)"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Verify", " ", "they", " ", "are", " ", "mutually", " ", "exclusive", " ", 
     RowBox[{"(", 
      RowBox[{"intersection", " ", "is", " ", "empty"}], ")"}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{"isMutuallyExclusive", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Intersection", "[", 
        RowBox[{"eventA", ",", " ", "eventB"}], "]"}], " ", "==", " ", 
       RowBox[{"{", "}"}]}], ")"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Evaluate", " ", "Axiom", " ", "3", " ", "condition"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"unionEvent", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{"eventA", ",", " ", "eventB"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"axiom3Verified", " ", "=", " ", 
     RowBox[{"isMutuallyExclusive", " ", "&&", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"pEvent", "[", "unionEvent", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"pEvent", "[", "eventA", "]"}], " ", "+", " ", 
         RowBox[{"pEvent", "[", "eventB", "]"}]}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Axiom 3 (Additivity) Verified: \>\"", ",", " ", 
      "axiom3Verified"}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Output", ":", " ", "True"}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", " ", "VERIFYING"}]}], " ", 
      RowBox[{"THEOREMS", " ", "--"}]}], "-"}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Theorem", " ", "1"}], ":", " ", 
     RowBox[{
     "Complement", " ", "Rule", " ", "verification", " ", "for", " ", 
      "eventA"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"complementA", " ", "=", " ", 
     RowBox[{"Complement", "[", 
      RowBox[{"sampleSpace", ",", " ", "eventA"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"theorem1Verified", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"pEvent", "[", "complementA", "]"}], " ", "==", " ", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"pEvent", "[", "eventA", "]"}]}]}], ")"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Theorem", " ", "2"}], ":", " ", 
     RowBox[{"Empty", " ", "Set", " ", "verification"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"theorem2Verified", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"pEvent", "[", 
        RowBox[{"{", "}"}], "]"}], " ", "==", " ", "0"}], ")"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Theorem 1 (Complement Rule) Verified: \>\"", ",", " ", 
      "theorem1Verified"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Theorem 2 (Empty Set = 0) Verified: \>\"", ",", " ", 
      "theorem2Verified"}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Output", " ", "Theorem", " ", "1"}], ":", " ", "True"}], " ", 
    "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Output", " ", "Theorem", " ", "2"}], ":", " ", "True"}], " ", 
    "*)"}], "\n"}]}]], "Code",
 CellChangeTimes->{4.000353316463642*^9},
 CellLabel->"In[98]:=",ExpressionUUID->"208c40c0-33e0-754d-a90b-c38173470964"],


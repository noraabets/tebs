Cell[CellGroupData[{

Cell[TextData[{
 "The equation of parabola through ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "0"], TraditionalForm]],ExpressionUUID->
  "186bc3db-fbce-1d43-9a76-0f70acde996c"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]],ExpressionUUID->
  "710929eb-6e96-374a-ada0-ef5dc22b9d91"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "2"], TraditionalForm]],ExpressionUUID->
  "0a399e67-7b67-da42-aaa5-5be74e4f0556"],
 " has the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["Ax",
       FontSlant->"Italic"], "2"], "+", 
     StyleBox["Bx",
      FontSlant->"Italic"], "+", "C"}]}], TraditionalForm]],ExpressionUUID->
  "69286a78-4088-f840-90ee-cbc7e5ed8dd5"],
 ". So the area under the parabola is "
}], "Item",
 CellChangeTimes->{{3.966607141375925*^9, 3.96660716404126*^9}, {
  3.9666072341196423`*^9, 
  3.96660747068462*^9}},ExpressionUUID->"cefead5f-e6d2-0742-b3b5-\
77e9a647534f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[Integral]", 
   RowBox[{"-", "h"}], "h"], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"A", "*", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"B", "*", "x"}], "+", "C"}], ")"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",
 InitializationCell->True,

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"x", "^", "2"}]}], "\n", 
 RowBox[{
  RowBox[{"a", "=", "0"}], ";", 
  RowBox[{"b", "=", "2"}], ";", 
  RowBox[{"n", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"h", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x0", "=", "a"}], ";", 
  RowBox[{"x1", "=", 
   RowBox[{"a", "+", "h"}]}], ";", 
  RowBox[{"x2", "=", "b"}], ";"}], "\n", 
 RowBox[{"simpson", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"h", "/", "3"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"f", "[", "x0", "]"}], "+", 
      RowBox[{"4", " ", 
       RowBox[{"f", "[", "x1", "]"}]}], "+", 
      RowBox[{"f", "[", "x2", "]"}]}], ")"}]}], "//", "N"}]}], "\n"}], "Input",
 CellChangeTimes->{{3.966619984012169*^9, 3.966619984012169*^9}, {
  3.9671717420154514`*^9, 3.967171743337076*^9}},

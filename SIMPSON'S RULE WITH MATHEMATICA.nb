  3.9666200868955116`*^9}},ExpressionUUID->"4dd46acd-0f22-944a-97cd-\
9469d904010c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"1", "/", "x"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "=", "1"}], ";", 
   RowBox[{"b", "=", "2"}], ";", 
   RowBox[{"n", "=", "10"}], ";", 
   RowBox[{"h", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SimpsonRule", "[", 
    RowBox[{"f_", ",", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_"}], "}"}], ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", ",", "sum"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", "n", "]"}], ",", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<n must be even\>\"", "]"}], ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"h", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sum", "=", 
       RowBox[{
        RowBox[{"f", "[", "a", "]"}], "+", 
        RowBox[{"f", "[", "b", "]"}], "+", 
        RowBox[{"4", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"a", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", " ", "k"}], "-", "1"}], ")"}], " ", "h"}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", 
             RowBox[{"n", "/", "2"}]}], "}"}]}], "]"}]}], "+", 
        RowBox[{"2", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"a", "+", 
             RowBox[{"2", " ", "k", " ", "h"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", 
             RowBox[{
              RowBox[{"n", "/", "2"}], "-", "1"}]}], "}"}]}], "]"}]}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"h", "/", "3"}], ")"}], " ", "sum"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"approx", "=", 
  RowBox[{"N", "[", 
   RowBox[{"SimpsonRule", "[", 
    RowBox[{"f", ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}], ",", "n"}], "]"}], "]"}]}], "\n", 
 RowBox[{"exact", "=", 
  RowBox[{"N", "[", 
   RowBox[{"Log", "[", "2", "]"}], "]"}]}], "\n", 
 RowBox[{"error", "=", 
  RowBox[{"approx", "-", "exact"}]}], "\n"}], "Input",
 CellChangeTimes->{{3.966621299489361*^9, 3.966621299489361*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"bf98024e-e3b5-724d-b9e4-609d4fcaf776"],


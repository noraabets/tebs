Cell[TextData[{
 "For interval ",
 StyleBox["h",
  FontSlant->"Italic"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]x", "=", 
    FractionBox[
     RowBox[{"b", "-", "a"}], "n"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "647eec74-c10b-e742-9fdf-6030f2cee796"],
 " we assume that ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is an even number. "
}], "Subitem",
 CellChangeTimes->{{3.966607536342848*^9, 3.966607874174444*^9}, {
